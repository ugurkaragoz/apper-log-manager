{
  "name": "apper/log-manager",
  "description": "Apper platformunda kullanıcı hareketlerini merkezi olarak kaydeden log sistemi",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/ugurkaragoz/apper-log-manager",
  "keywords": [
    "laravel",
    "logging",
    "audit",
    "apper"
  ],
  "authors": [
    {
      "name": "Uğur Karagöz",
      "email": "ugurkaragoz@yandex.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "laravel/pint": "^1.0",
    "mockery/mockery": "^1.5"
  },
  "autoload": {
    "psr-4": {
      "Apper\\LogManager\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Apper\\LogManager\\LogServiceProvider"
      ]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Apper\\LogManager\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
